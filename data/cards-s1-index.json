 "source_revision_note": "Git commit that added every shard below. Each shard digest is the SHA-256 of the file bytes at that commit, and owner_at_source is the organization that held the slot in editions.json at that commit.",
 "description": "Synthetic decision-point case cards, built for research. Each card is written as a decision point in one synthetic company with options, participants, channel, and evaluator-only invariants; some published stage-1 situation texts also disclose how the case ended, and evaluator-only invariants often summarize how the case resolved (strip invariants and curate leaked texts before blind runs). The separate reference_outcome field is held back for evaluation and is not included. Stage-1 cards do not carry a refutation condition yet; one is to be written and fixed for each card before its first judged run. Each file belongs to one organization, named by its immutable org id; the edition number is only the roster slot the organization held when the file was built.",
 "fields": {
  "card_id": "stable card identifier, unique across every file",
  "edition": "roster slot (edition number) of the organization when the card was built; a display slot, not an identity",
  "situation": "written as the situation before the decision; some published stage-1 texts also disclose how the case ended and require curation before blind runs",
  "options": "the choices on the table",
  "invariants": "evaluator-only organizational properties the case keeps; often summarizes how the case resolved and must be stripped from agent inputs",
  "participants": "roster ids of the members involved",
  "channel": "office channel id",
  "opener": "roster id of the member who opens the conversation"
 },
 "not_included": {
  "reference_outcome": "held back for evaluation",
  "refutation_condition": "not written for stage-1 cards yet; fixed for each card before its first judged run"
 },
